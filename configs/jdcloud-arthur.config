# ============================================================
# JDCloud Arthur (RE-SS-01) OpenWrt Build Configuration
# Target: Qualcomm IPQ60xx (qualcommax/ipq60xx/jdcloud_re-ss-01)
#   *** JDCloud RE-SS-01 ONLY - do NOT use for ZN-M2 / Cudy / newifi ***
# Source: VIKINGYFY/ImmortalWrt main (NSS Full Support)
# Kernel: 6.18 with eBPF/BTF enabled (required by dae)
# Device: JDCloud RE-SS-01 (AX1800 Pro), eMMC flash
#   Ports: lan1(dp2) / lan2(dp3) / lan3(dp4) / wan(dp5)
# Memory: 1GB RAM, 512MB swap (existing) + 256MB zram
# Disk: ~111GB (mmcblk0p27) for overlay expansion + Docker + NAS
# Design doc: ~/workspace/your_files/jdcloud-arthur-firmware-design/
# User confirmed 2026-10-19: ① all 5 optional features ON
#   (AdGuardHome/Aria2 via Docker, NOT in firmware;
#    Samba/DDNS/UPnP IN firmware)
#   ② reboot/cleanup cron times set manually by user
#      (preset as COMMENTED entries in files/etc/crontabs/root)
#   ③ 111GB partition plan 20/30/50/11GB unchanged
# ============================================================

# --- Target ---
# TRIPLE-CHECKED 2026-10-19: device jdcloud_re-ss-01 exists in
# VIKINGYFY/immortalwrt main target/linux/qualcommax/image/ipq60xx.mk
# (DEVICE_VENDOR := JDCloud, DEVICE_MODEL := RE-SS-01, SOC := ipq6000)
# Uses Device/EmmcImage -> outputs factory.bin + sysupgrade.bin (NOT .ubi)
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_jdcloud_re_ss_01=y

# --- Kernel options ---
CONFIG_KERNEL_ZRAM=y
CONFIG_KERNEL_ZRAM_WRITEBACK=y
CONFIG_KERNEL_ZRAM_MEMORY_LIMIT=256
CONFIG_KERNEL_SWAP=y
CONFIG_KERNEL_CGROUPS=y

# DEVEL: expose developer options so the BPF_TOOLCHAIN choice
# (prompt "BPF toolchain" if DEVEL) is settable; without it,
# make defconfig silently drops CONFIG_BPF_TOOLCHAIN_HOST.
CONFIG_DEVEL=y

# --- eBPF / BTF (REQUIRED by dae) ---
CONFIG_KERNEL_DEBUG_INFO=y
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set
CONFIG_KERNEL_DEBUG_INFO_BTF=y
CONFIG_KERNEL_CGROUP_BPF=y
CONFIG_KERNEL_BPF_EVENTS=y
CONFIG_BPF_TOOLCHAIN_HOST=y
CONFIG_KERNEL_XDP_SOCKETS=y

# --- Filesystem ---
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_SQUASHFS_BLOCK_SIZE=256
# CONFIG_TARGET_ROOTFS_EXT4 is not set
# CONFIG_TARGET_ROOTFS_TARGZ is not set
# CONFIG_TARGET_ROOTFS_CPIOGZ is not set
# CONFIG_TARGET_ROOTFS_JFFS2 is not set
# CONFIG_TARGET_ROOTFS_UBIFS is not set

# --- Image options ---
# eMMC device: 512MB rootfs (firmware + packages; 111GB disk handles the rest)
CONFIG_TARGET_ROOTFS_PARTSIZE=512

# --- Base system ---
CONFIG_PACKAGE_base-files=y
CONFIG_PACKAGE_busybox=y
CONFIG_PACKAGE_dnsmasq=y
CONFIG_PACKAGE_dnsmasq_full_dhcp=y
CONFIG_PACKAGE_dnsmasq_full_dhcpv6=y
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_fstools=y
CONFIG_PACKAGE_iwinfo=y
CONFIG_PACKAGE_kernel=y
CONFIG_PACKAGE_libc=y
CONFIG_PACKAGE_libgcc=y
CONFIG_PACKAGE_libpthread=y
CONFIG_PACKAGE_librt=y
CONFIG_PACKAGE_logd=y
CONFIG_PACKAGE_mtd=y
CONFIG_PACKAGE_netifd=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_opkg=y
CONFIG_PACKAGE_procd=y
CONFIG_PACKAGE_ubox=y
CONFIG_PACKAGE_ubus=y
CONFIG_PACKAGE_ubusd=y
CONFIG_PACKAGE_uci=y
CONFIG_PACKAGE_uclient-fetch=y
CONFIG_PACKAGE_urandom-seed=y
CONFIG_PACKAGE_urngd=y
CONFIG_PACKAGE_usign=y

# --- IPv6 ---
# CONFIG_PACKAGE_ip6tables-nft is not set
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y

# --- LuCI Web Interface ---
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-status=y

# Default bootstrap theme (keep minimal; user can switch)
CONFIG_PACKAGE_luci-theme-bootstrap=y
# CONFIG_PACKAGE_luci-theme-argon is not set

# --- Chinese (Simplified) ---
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y

# LuCI applications - system
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-package-manager=y

# --- DAEDE (transparent proxy, kenzok8 edition) ---
# Same verified combo as ZN-M2 v4 (user confirmed working 2026-10-17):
# dae 2026.09.30 (core) + luci-app-daede 1.15 (LuCI UI + :2023 standalone UI)
# Do NOT install daed backend (saves memory; 1GB RAM but keep it lean).
# Cloned from kenzok8/openwrt-daede into package/ by diy-part2.sh.
CONFIG_PACKAGE_dae=y
# CONFIG_PACKAGE_daed is not set (use dae + luci-app-daede for less memory)
CONFIG_PACKAGE_luci-app-daede=y
# CONFIG_PACKAGE_luci-app-daed is not set (replaced by luci-app-daede)
# v2ray-geoip/geosite: required by daed's Makefile, keep them
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-geosite=y

# --- Tailscale (remote management over tailnet) ---
# NOTE (ZN-M2 v4 lesson 2026-10-17): luci-app-tailscale was in .config but
# silently dropped from the build (feeds missing). Workflow checks for it
# with WARNING (not fatal). tailscale CLI always works.
CONFIG_PACKAGE_tailscale=y
CONFIG_PACKAGE_luci-app-tailscale=y
CONFIG_PACKAGE_luci-i18n-tailscale-zh-cn=y

# --- Network tools (minimal: fw4/nftables only, no iptables compat) ---
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ip-bridge=y
# CONFIG_PACKAGE_iptables-nft is not set
# CONFIG_PACKAGE_kmod-ipt-core is not set
CONFIG_PACKAGE_kmod-nf-iptables=y
# CONFIG_PACKAGE_kmod-nft-compat is not set
# CONFIG_PACKAGE_kmod-ipt-conntrack is not set
# CONFIG_PACKAGE_kmod-ipt-nat is not set
# CONFIG_PACKAGE_kmod-ipt-nathelper is not set
# CONFIG_PACKAGE_kmod-nf-nathelper is not set
# CONFIG_PACKAGE_kmod-nf-nathelper-extra is not set
# CONFIG_PACKAGE_kmod-nf-ipt is not set
# CONFIG_PACKAGE_kmod-nf-ipt6 is not set
# CONFIG_PACKAGE_kmod-ip6tables is not set

# Multicast / IGMP kernel modules
# CONFIG_PACKAGE_kmod-ipt-igmp is not set
CONFIG_PACKAGE_kmod-nf-conntrack=y
CONFIG_PACKAGE_kmod-nf-conntrack6=y

# VLAN support
CONFIG_PACKAGE_kmod-8021q=y

# Bridge / network
CONFIG_PACKAGE_kmod-bridge=y
CONFIG_PACKAGE_kmod-nf-conntrack-netlink=y

# PPPoE (broadband dialing - configure your own account in LuCI)
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_kmod-ppp=y
CONFIG_PACKAGE_kmod-pppoe=y
CONFIG_PACKAGE_kmod-pppox=y

# --- WiFi ---
# RE-SS-01 (IPQ6000 SoC, same as ZN-M2): on-chip AHB WiFi.
# Upstream DEFAULT_PACKAGES ships kmod-ath11k/ahb/pci + wpad-openssl.
CONFIG_PACKAGE_kmod-ath11k=y
CONFIG_PACKAGE_kmod-ath11k-ahb=y
# CONFIG_PACKAGE_kmod-ath11k-pci is not set (on-chip WiFi is AHB, no PCIe)
CONFIG_PACKAGE_ath11k-firmware-ipq6018-ddwrt=y
CONFIG_PACKAGE_wpad-openssl=y

# --- Utilities ---
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_BUSYBOX_CONFIG_BASE64=y
# CONFIG_PACKAGE_curl is not set
# CONFIG_PACKAGE_wget-ssl is not set

# --- SSL ---
CONFIG_PACKAGE_libustream-openssl=y
CONFIG_PACKAGE_libopenssl=y

# --- NSS / Hardware acceleration ---
# Same as ZN-M2 v4: ECM DISABLED (caused total LAN death on IPQ60xx),
# keep nss-dp (data plane driver) for Ethernet ports.
CONFIG_PACKAGE_kmod-qca-nss-drv=y
# CONFIG_PACKAGE_kmod-qca-nss-ecm is not set (DISABLED - see above)
CONFIG_PACKAGE_kmod-qca-nss-dp=y
CONFIG_PACKAGE_kmod-qca-ssdk=y
# CONFIG_PACKAGE_kmod-qca-nss-crypto is not set
CONFIG_PACKAGE_nss-firmware=y

# NSS driver submodules
CONFIG_PACKAGE_kmod-qca-nss-drv-bridge-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-vlan-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-igs=y
CONFIG_PACKAGE_kmod-qca-nss-drv-match=y
CONFIG_PACKAGE_kmod-qca-nss-drv-mirror=y
CONFIG_PACKAGE_kmod-qca-nss-drv-netlink=y
CONFIG_PACKAGE_kmod-qca-nss-drv-qdisc=y
# CONFIG_PACKAGE_kmod-qca-nss-drv-gre is not set (kmod-gre removed)

# --- Disabled: redundant packages (same slim list as ZN-M2 v4) ---
# Tunnel modules + their NSS submodules (must remove together)
# CONFIG_PACKAGE_kmod-bonding is not set
# CONFIG_PACKAGE_kmod-qca-nss-drv-lag-mgr is not set
# CONFIG_PACKAGE_kmod-gre is not set
# CONFIG_PACKAGE_kmod-qca-nss-drv-gre is not set
# CONFIG_PACKAGE_kmod-qca-nss-drv-eogremgr is not set
# CONFIG_PACKAGE_kmod-pptp is not set
# CONFIG_PACKAGE_kmod-qca-nss-drv-pptp is not set
# CONFIG_PACKAGE_kmod-vxlan is not set
# CONFIG_PACKAGE_kmod-qca-nss-drv-vxlanmgr is not set
# CONFIG_PACKAGE_kmod-l2tp is not set
# CONFIG_PACKAGE_kmod-qca-nss-drv-l2tpv2 is not set
# CONFIG_PACKAGE_kmod-nat46 is not set
# CONFIG_PACKAGE_kmod-qca-nss-drv-map-t is not set
# CONFIG_PACKAGE_kmod-sit is not set
# CONFIG_PACKAGE_kmod-qca-nss-drv-tun6rd is not set
# CONFIG_PACKAGE_kmod-qca-nss-drv-tunipip6 is not set
# 4G/5G modules
# CONFIG_PACKAGE_kmod-mhi-bus is not set
# CONFIG_PACKAGE_kmod-qrtr-mhi is not set
# Misc
# CONFIG_PACKAGE_kmod-macvlan is not set

# --- ZRAM swap + htop ---
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_htop=y
# CONFIG_PACKAGE_nano is not set

# --- Web terminal ---
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_luci-app-ttyd=y

# --- Disk management (design doc section 4) ---
# luci-app-diskman + dependencies for 111GB disk management
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_ntfs-3g=y
CONFIG_PACKAGE_block-mount=y
# CONFIG_PACKAGE_kmod-fs-exfat is not set
# CONFIG_PACKAGE_kmod-fs-ntfs3 is not set
# CONFIG_PACKAGE_kmod-fs-f2fs is not set

# --- USB (keep for USB disk / SMART) ---
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y

# --- Docker (design doc sections 6-8) ---
# dockerd + compose; data dir /opt/docker on 111GB partition (post-flash setup)
# AdGuardHome + Aria2 run as Docker containers (NOT baked into firmware)
CONFIG_PACKAGE_dockerd=y
CONFIG_PACKAGE_docker-compose=y
CONFIG_PACKAGE_luci-app-dockerman=y

# --- Samba (user confirmed: install all 5) ---
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_samba4-server=y

# --- DDNS (user confirmed: install all 5) ---
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_ddns-scripts=y

# --- UPnP (user confirmed: install all 5) ---
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_miniupnpd-nftables=y

# --- Explicitly NOT in firmware ---
# AdGuardHome / Aria2 -> Docker containers (design doc section 11)
# passwall / openclash -> dae replaces them
# CONFIG_PACKAGE_luci-app-passwall is not set
# CONFIG_PACKAGE_passwall is not set
# CONFIG_PACKAGE_xray-core is not set
# CONFIG_PACKAGE_sing-box is not set
# CONFIG_PACKAGE_luci-app-openclash is not set
# CONFIG_PACKAGE_luci-app-homeproxy is not set
# CONFIG_PACKAGE_luci-app-turboacc is not set
# CONFIG_PACKAGE_kmod-nft-fullcone is not set
# CONFIG_PACKAGE_luci-theme-argon is not set
# CONFIG_PACKAGE_luci-app-argon-config is not set
# CONFIG_PACKAGE_luci-app-frpc is not set
# CONFIG_PACKAGE_luci-app-frps is not set
# CONFIG_PACKAGE_luci-app-wol is not set
# CONFIG_PACKAGE_luci-app-qbittorrent is not set
# CONFIG_PACKAGE_luci-app-transmission is not set
# CONFIG_PACKAGE_luci-app-vsftpd is not set
# CONFIG_PACKAGE_luci-app-nfs is not set
